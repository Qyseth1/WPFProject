<Window x:Class="LilysBookShop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LilysBookShop"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <DockPanel>
        <!-- Menu bar -->
        <Menu DockPanel.Dock="Top">

            <!-- File Menu -->
            <MenuItem Header="_File">
                <MenuItem Header="_New" Command="{Binding NewCommand}"/>
                <MenuItem Header="_Open" Command="{Binding OpenCommand}"/>
                <Separator/>
                <MenuItem Header="_Exit" Command="{Binding SaveCommand}"/>
            </MenuItem>

            <!-- Window Menu --><!--
            <MenuItem Header="_Window">
                <MenuItem Header="_Minimize" Click="Minimize_Click"/>
                <MenuItem Header="_Maximize" Click="Maximize_Click"/>
            </MenuItem>-->

            <!-- Help Menu -->
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Command="{Binding AboutCommand}"/>
            </MenuItem>

        </Menu>

        <!-- Main content -->
        <Grid>
            <TextBlock Text="Välkommen till Lilys Bookshop!"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       FontSize="15"/>
        </Grid>
    </DockPanel>
</Window>
